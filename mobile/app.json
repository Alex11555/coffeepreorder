{
  "expo": {
    "name": "CoffeePreorderQR",
    "slug": "coffee-preorder-qr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a0a04"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.coffeepreorderqr"
    },
    "android": {
      "package": "com.example.coffeepreorderqr",
      "backgroundColor": "#1a0a04"
    },
    "backgroundColor": "#1a0a04",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9958af70-aeaf-4ce8-9dd2-effd468e3437"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#d4802a"
        }
      ]
    ]
  }
}
