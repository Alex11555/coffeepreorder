# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coffeepreorder?schema=public"

# Used to sign JWTs — change to a long random string
JWT_SECRET="change-me-to-a-long-random-string"

# How long auth tokens last
JWT_EXPIRES_IN="7d"

# HTTP port
PORT=4000

# Shared secret the Raspberry Pi uses to talk to /api/locker-hub
LOCKER_HUB_KEY=
