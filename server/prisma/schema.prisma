// CoffeePreorderQR — Prisma schema
// Postgres-backed. Run `npx prisma migrate dev --name init` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
}

enum OrderStatus {
  PAID         // payment captured, waiting on barista
  PREPARING    // barista is making it
  READY        // dropped in the compartment, awaiting pickup
  PICKED_UP    // door opened, done
  CANCELLED
}

enum LockerStatus {
  AVAILABLE
  RESERVED   // assigned to an active order
  OCCUPIED   // coffee is sitting inside, waiting for pickup
  OFFLINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  googleId     String?  @unique
  avatarUrl    String?
  role         Role     @default(CUSTOMER)
  // Loyalty: `points` is the spendable balance; `lifetimePoints` only ever
  // grows and determines the membership tier (Bronze/Silver/Gold/Platinum).
  points         Int    @default(0)
  lifetimePoints Int    @default(0)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  emoji       String?
  category    String?
  available   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

// A physical compartment (one solenoid) in the single locker cabinet.
// `number` maps to a GPIO pin on the Raspberry Pi (see pi/locker_hub.py).
model Locker {
  id            String       @id @default(cuid())
  number        Int          @unique
  location      String       // shared label for the whole cabinet, e.g. "Coffee Counter"
  status        LockerStatus @default(AVAILABLE)
  // Set true when a door should physically open. The Pi polls for these,
  // pulses the solenoid, then acks (sets it back to false).
  unlockPending Boolean      @default(false)
  orders        Order[]
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  lockerId     String
  locker       Locker      @relation(fields: [lockerId], references: [id])
  status       OrderStatus @default(PAID)
  totalCents   Int
  // Loyalty bookkeeping for this order (so cancellations can reverse cleanly).
  pointsEarned   Int       @default(0)
  pointsRedeemed Int       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  qrCode       QrCode?
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  priceCents Int
  notes      String?
}

model QrCode {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  usedAt     DateTime?
}
