# CoffeePreorderQR Pi scanner config

# Your live backend URL (the one you deployed to Render)
API_URL=https://coffeepreorder.onrender.com

LOCKER_HUB_KEY=3a26845b38de706d4ee6742886f52217

# Which locker is this Pi physically attached to?
# Must match a Locker.number in the database (the seed creates 1..6).
LOCKER_NUMBER=1

# BCM GPIO pin wired to the relay's IN pin (pin 11 on the header = GPIO17)
RELAY_PIN=17

# Most cheap blue relay modules are active-low (driven LOW = switch on).
# If your relay clicks ON at boot or stays closed, flip this to true.
RELAY_ACTIVE_HIGH=false

# How long to hold the solenoid unlocked.
PULSE_SECONDS=3

# Ignore the same QR for this many seconds after a successful read,
# so a phone held still doesn't fire twice.
COOLDOWN_SECONDS=5

# /dev/video0 is index 0. Bump to 1 if you have multiple cameras.
CAMERA_INDEX=0
